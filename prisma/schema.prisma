datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  CONTENT_MANAGER
  EDITOR
  VIEWER
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum EngagementType {
  PROJECT
  RETAINER
  STAFF_AUGMENTATION
  PRODUCT_BUILD
}


model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(EDITOR)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  blogPosts    BlogPost[]
  caseStudies  CaseStudy[]
  logs         ActivityLog[]
}

model BlogPost {
  id                 String           @id @default(uuid())
  title              String
  slug               String           @unique
  contentJson        Json
  contentHtml        String
  contentText        String
  excerpt            String
  featuredImage      String?
  featuredImageAlt   String?
  isFeatured         Boolean          @default(false)
  status             ContentStatus    @default(DRAFT)
  publishedAt        DateTime?
  scheduledAt        DateTime?
  guestAuthor        String?
  internalNote       String?
  serviceIds         String[]         // Services related
  caseStudyIds       String[]         // Case studies related
  contentBriefUrl    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  
  // Relations
  authorId           String
  author             User             @relation(fields: [authorId], references: [id])
  categoryId         String?
  category           Category?        @relation(fields: [categoryId], references: [id])
  tags               Tag[]            // many-to-many (join table _BlogPostToTag)
  seoMetaId          String?          @unique
  seoMeta            SeoMeta?         @relation(fields: [seoMetaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  aeoGeoMetaId       String?          @unique
  aeoGeoMeta         AeoGeoMeta?      @relation(fields: [aeoGeoMetaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schemaSettingsId   String?          @unique
  schemaSettings     SchemaSettings?  @relation(fields: [schemaSettingsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions           VersionHistory[]
}

model CaseStudy {
  id                     String               @id @default(uuid())
  title                  String
  slug               String           @unique
  clientName             String
  clientLogo             String?
  industry               String
  engagementType         EngagementType       @default(PROJECT)
  publishedAt            DateTime?
  scheduledAt            DateTime?
  heroImage              String?
  heroImageAlt           String?
  excerpt                String
  isFeatured             Boolean              @default(false)
  showMetricsOnTop       Boolean              @default(false)
  serviceIds             String[]
  blogPostIds            String[]
  internalNote           String?
  challengeHtml          String
  challengeJson          Json
  approachHtml           String
  approachJson           Json
  // Page builder: block layout (rows → columns → blocks) and the template it started from.
  // Null = legacy case study, rendered with the "classic" (live) template order.
  layoutJson             Json?
  templateId             String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  
  // Testimonial
  testimonialQuote       String?
  testimonialName        String?
  testimonialDesignation String?
  testimonialCompany     String?
  testimonialImage       String?

  // CTA
  ctaHeading             String?
  ctaBody                String?
  ctaButtonLabel         String?
  ctaButtonUrl           String?

  // Relations
  authorId               String
  author                 User                 @relation(fields: [authorId], references: [id])
  resultStats            ResultStat[]
  processSteps           ProcessStep[]
  mediaGallery           MediaGalleryItem[]
  seoMetaId              String?              @unique
  seoMeta                SeoMeta?             @relation(fields: [seoMetaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  aeoGeoMetaId           String?              @unique
  aeoGeoMeta             AeoGeoMeta?          @relation(fields: [aeoGeoMetaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schemaSettingsId       String?              @unique
  schemaSettings         SchemaSettings?      @relation(fields: [schemaSettingsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions               VersionHistory[]
  faqs                   CaseStudyFaq[]
}

model CaseStudyFaq {
  id          String    @id @default(uuid())
  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}


model ResultStat {
  id          String    @id @default(uuid())
  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  value       String
  label       String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProcessStep {
  id          String    @id @default(uuid())
  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  title       String
  description String
  icon        String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MediaGalleryItem {
  id          String    @id @default(uuid())
  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  imagePath   String
  caption     String?
  alt         String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SeoMeta {
  id                String     @id @default(uuid())
  blogPost          BlogPost?
  caseStudy         CaseStudy?
  title             String
  description       String
  focusKeyword      String
  secondaryKeywords String[]
  canonicalUrl      String?
  index             Boolean    @default(true)
  follow            Boolean    @default(true)
  ogTitle           String?
  ogDescription     String?
  ogImage           String?
  twitterCardType   String     @default("summary_large_image")
}

model AeoGeoMeta {
  id                 String     @id @default(uuid())
  blogPost           BlogPost?
  caseStudy          CaseStudy?
  directAnswerPrompt String?
  snippetCandidate   String? // max 50 words
  peopleAlsoAsk      Json?      // list of Q&A objects
  semanticSummary    String?
  keyTakeaways       String[]
  statsSources       Json?      // list of sources
  authorCredibility  String?
  reviewedBy         String?
  allowAiCrawler     Boolean    @default(true)
}

model SchemaSettings {
  id               String     @id @default(uuid())
  blogPost         BlogPost?
  caseStudy        CaseStudy?
  type             String     // e.g. "BlogPosting", "CaseStudy"
  customSchemaJson Json?      // Overrides/additions
}

model MediaAsset {
  id           String       @id @default(uuid())
  filename     String
  filepath     String
  url          String
  optimizedUrl String?
  size         Int
  mimeType     String
  width        Int?
  height       Int?
  alt          String?
  caption      String?
  tags         String[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  folderId     String?
  folder       MediaFolder? @relation(fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model MediaFolder {
  id        String       @id @default(uuid())
  name      String
  parentId  String?
  parent    MediaFolder? @relation("SubFolders", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  MediaFolder[] @relation("SubFolders")
  path      String       @unique
  assets    MediaAsset[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Redirect {
  id         String   @id @default(uuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]
}

model Tag {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     BlogPost[]
}

model SiteSettings {
  id        String   @id @default(uuid())
  orgName   String   @default("Vionsys")
  orgLogo   String?
  orgUrl    String   @default("https://vionsys.com")
  sameAs    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id        String    @id @default(uuid())
  name      String
  keyHash   String    @unique
  role      Role      @default(VIEWER)
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model VersionHistory {
  id          String     @id @default(uuid())
  blogPostId  String?
  blogPost    BlogPost?  @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  caseStudyId String?
  caseStudy   CaseStudy? @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  contentJson Json
  contentHtml String
  authorId    String
  createdAt   DateTime   @default(now())
}

// --- AI document import + per-document RAG (case studies and blog posts) ------------
// A document (PDF/DOCX) uploaded to a case study or blog post. Its text is split into
// chunks with embeddings so "Ask AI" can answer from that item's own documents only.
// Collection and field names are mapped to the original case-study-only names, so data
// uploaded before blog support was added keeps working without a migration.
model ContentSource {
  id          String   @id @default(uuid())
  /// Case study or blog post id (UUIDs, so ids never collide across types).
  ownerId     String   @map("caseStudyId")
  /// "case-study" | "blog". Null on records created before blog support (= case study).
  ownerType   String?
  fileName    String
  mimeType    String
  size        Int
  /// Unused: original files are not stored (the media bucket serves public URLs).
  fileUrl     String?
  text        String
  chunkCount  Int      @default(0)
  uploadedBy  String
  createdAt   DateTime @default(now())

  @@index([ownerId])
  @@map("CaseStudySource")
}

model ContentSourceChunk {
  id        String  @id @default(uuid())
  sourceId  String
  ownerId   String  @map("caseStudyId")
  position  Int
  text      String
  /// gemini-embedding-001 vector (768 dimensions).
  embedding Float[]

  @@index([ownerId])
  @@index([sourceId])
  @@map("SourceChunk")
}
